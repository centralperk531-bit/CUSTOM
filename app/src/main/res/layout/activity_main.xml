<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        app:title=""> <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/app_name"
            android:textColor="#FFEB3B"
            android:textSize="28sp"
            android:textStyle="bold|italic"
            android:fontFamily="cursive" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Fondo beige con tabs redondeados -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F1E8"
        android:elevation="4dp"
        app:tabTextColor="#8B7355"
        app:tabSelectedTextColor="#3E3428"
        app:tabIndicatorColor="#8B7355"
        app:tabIndicatorHeight="4dp"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabRippleColor="#20000000"/>

    <!-- FrameLayout que contiene todas las pestañas -->
    <FrameLayout
        android:id="@+id/tabContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TAB 1 CALENDARIO -->
        <ScrollView
            android:id="@+id/tabCalendar"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="500dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/calendarViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="500dp"/>

                <!-- Guardar Configuración (encima) -->
                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                    android:id="@+id/btnSaveConfigCalendar"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="72dp"
                    android:layout_marginEnd="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:minHeight="0dp"
                    android:text="Guardar"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    app:icon="@android:drawable/ic_menu_save"/>

                <!-- PDF (abajo) -->
                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                    android:id="@+id/fabExportPdf"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="16dp"
                    android:layout_marginEnd="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:minHeight="0dp"
                    android:text="PDF"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    app:cornerRadius="8dp"
                    app:icon="@android:drawable/ic_menu_save"
                    app:backgroundTint="#5E5240" />

            </FrameLayout>

        </ScrollView>

        <!-- TAB 2: CONSULTAR -->
        <ScrollView
            android:id="@+id/tabSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_search_date"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="12dp"/>

                        <DatePicker
                            android:id="@+id/datePickerSearch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:datePickerMode="spinner"
                            android:calendarViewShown="false"
                            android:layout_marginBottom="16dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSearch"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:text="@string/btn_search"
                            android:textSize="16sp"
                            app:cornerRadius="8dp"
                            app:icon="@android:drawable/ic_menu_search"
                            android:contentDescription="@string/cd_search_button"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#E3F2FD">

                    <TextView
                        android:id="@+id/tvResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:padding="16dp"
                        android:minHeight="100dp"
                        android:textColor="#1565C0"
                        android:text=""/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 3: ESTADÍSTICAS -->

        <!-- NUEVO CONTENIDO PARA EL TABSTATS -->
               <ScrollView
            android:id="@+id/tabStats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Título -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 Estadísticas de Custodia"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingBottom="16dp" />

                <!-- RadioGroup para seleccionar modo -->
                <RadioGroup
                    android:id="@+id/radioGroupStatsMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <RadioButton
                        android:id="@+id/radioStatsYearMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🗓️ Año en curso (2026)"
                        android:textSize="16sp"
                        android:checked="true"
                        android:paddingVertical="8dp" />

                    <RadioButton
                        android:id="@+id/radioStatsCustomMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📅 Período personalizado"
                        android:textSize="16sp"
                        android:paddingVertical="8dp" />
                </RadioGroup>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#CCCCCC"
                    android:layout_marginVertical="8dp" />

                <!-- Selector de fechas (solo visible en modo personalizado) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fecha de inicio:"
                        android:textSize="14sp"
                        android:paddingBottom="4dp" />

                    <EditText
                        android:id="@+id/edtStatsStartDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="dd/MM/yyyy"
                        android:inputType="none"
                        android:focusable="false"
                        android:clickable="true"
                        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                        android:padding="12dp"
                        android:enabled="false"
                        android:background="@android:drawable/edit_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fecha de fin:"
                        android:textSize="14sp"
                        android:paddingTop="12dp"
                        android:paddingBottom="4dp" />

                    <EditText
                        android:id="@+id/edtStatsEndDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="dd/MM/yyyy"
                        android:inputType="none"
                        android:focusable="false"
                        android:clickable="true"
                        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                        android:padding="12dp"
                        android:enabled="false"
                        android:background="@android:drawable/edit_text" />

                    <Button
                        android:id="@+id/btnCalculateStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📊 Calcular Estadísticas"
                        android:textSize="16sp"
                        android:layout_marginTop="12dp"
                        android:padding="12dp" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#4CAF50"
                    android:layout_marginVertical="8dp" />

                <!-- ProgressBar (mientras calcula) -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <!-- Resultados -->
                <TextView
                    android:id="@+id/tvStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selecciona un período y pulsa Calcular"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:paddingTop="8dp"
                    android:fontFamily="monospace" />

            </LinearLayout>
        </ScrollView>

        <!-- TAB 4: CONFIGURACIÓN -->
        <ScrollView
            android:id="@+id/tabConfig"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPremium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⭐ Premium"
                    app:cornerRadius="8dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_marginBottom="16dp"/>

                <!-- Card Nombres -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="👥 Nombres"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="12dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/label_parent1"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtParent1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:maxLines="1"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/label_parent2"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtParent2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:maxLines="1"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ─── VISITAS ─────────────────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📅 Días de visita"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="12dp"/>

                        <!-- Custodio 1 -->
                        <TextView
                            android:id="@+id/tvVisitParent1Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Custodio 1"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <LinearLayout
                            android:id="@+id/llVisitDaysParent1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <CheckBox android:id="@+id/cbV1Mon" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="L" android:gravity="center"/>
                            <CheckBox android:id="@+id/cbV1Tue" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="M" android:gravity="center"/>
                            <CheckBox android:id="@+id/cbV1Wed" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="X" android:gravity="center"/>
                            <CheckBox android:id="@+id/cbV1Thu" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="J" android:gravity="center"/>
                            <CheckBox android:id="@+id/cbV1Fri" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="V" android:gravity="center"/>
                            <CheckBox android:id="@+id/cbV1Sat" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="S" android:gravity="center"/>
                            <CheckBox android:id="@+id/cbV1Sun" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="D" android:gravity="center"/>
                        </LinearLayout>

                        <!-- Custodio 2 -->
                        <TextView
                            android:id="@+id/tvVisitParent2Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Custodio 2"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <LinearLayout
                            android:id="@+id/llVisitDaysParent2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <CheckBox android:id="@+id/cbV2Mon" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="L" android:gravity="center"/>
                            <CheckBox android:id="@+id/cbV2Tue" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="M" android:gravity="center"/>
                            <CheckBox android:id="@+id/cbV2Wed" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="X" android:gravity="center"/>
                            <CheckBox android:id="@+id/cbV2Thu" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="J" android:gravity="center"/>
                            <CheckBox android:id="@+id/cbV2Fri" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="V" android:gravity="center"/>
                            <CheckBox android:id="@+id/cbV2Sat" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="S" android:gravity="center"/>
                            <CheckBox android:id="@+id/cbV2Sun" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="D" android:gravity="center"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ─────────────────────────────────────────────────────── -->
                <!-- Card Años Pares/Impares -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📅 Años Pares/Impares"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Esta configuración afecta automáticamente al verano (julio-agosto). Navidad y Semana Santa se configuran manualmente."
                            android:textSize="12sp"
                            android:textColor="#999999"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Quién empieza en años PARES:"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="4dp"/>

                        <Spinner
                            android:id="@+id/spinnerEvenYearStarts"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:drawable/btn_dropdown"
                            android:padding="12dp"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Quién empieza en años IMPARES:"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="4dp"/>

                        <Spinner
                            android:id="@+id/spinnerOddYearStarts"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:drawable/btn_dropdown"
                            android:padding="12dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card Patrones -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚙️ Configuración de Custodia"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Fecha de inicio de custodia"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="4dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Fecha de inicio"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:startIconDrawable="@android:drawable/ic_menu_my_calendar"
                            android:layout_marginBottom="16dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtStartDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:clickable="true"
                                android:cursorVisible="false"
                                android:hint="dd/MM/yyyy"
                                android:maxLines="1"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Quién empieza en la fecha de inicio:"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="4dp"/>

                        <Spinner
                            android:id="@+id/spinnerPatternStartsWith"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:drawable/btn_dropdown"
                            android:padding="12dp"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Modo de aplicación:"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="8dp"/>

                        <RadioGroup
                            android:id="@+id/radioGroupApplicationMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp">

                            <RadioButton
                                android:id="@+id/radioModeForward"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Desde enero del año actual hacia adelante"
                                android:checked="true"/>

                            <RadioButton
                                android:id="@+id/radioModeFromDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Cambiar desde la fecha marcada (resto año + venideros)"/>
                        </RadioGroup>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_custody_pattern"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="4dp"/>

                        <Spinner
                            android:id="@+id/spinnerPattern"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:drawable/btn_dropdown"
                            android:padding="12dp"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_change_day"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="4dp"/>

                        <Spinner
                            android:id="@+id/spinnerDay"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:drawable/btn_dropdown"
                            android:padding="12dp"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_summer_division"
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginBottom="4dp"/>

                        <Spinner
                            android:id="@+id/spinnerSummerDiv"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:drawable/btn_dropdown"
                            android:padding="12dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card Eventos y Períodos -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📝 Eventos Especiales"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="12dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManageSpecialDates"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Gestionar Fechas Especiales"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_marginBottom="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManagePatternChanges"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🔄 Cambiar orden de Custodia"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_marginBottom="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManageNoCustody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Gestionar Períodos Especiales"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_marginBottom="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManageChristmas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🎄 Navidad"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_marginBottom="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManageEaster"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🐣 Semana Santa"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card Copia de Seguridad -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💾 Copia de Seguridad"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="12dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveBackup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💾 Guardar Backup"
                            app:icon="@android:drawable/ic_menu_save"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_marginBottom="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRestoreBackup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📥 Restaurar Backup"
                            app:icon="@android:drawable/ic_menu_revert"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.OutlinedButton"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Botón borrar todo -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteAll"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="🗑️ Borrar"
                    android:textSize="16sp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="#B00020"
                    android:textColor="#B00020"
                    android:layout_marginBottom="16dp"/>

                <!-- Botón guardar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveConfig"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="@string/btn_save"
                    android:textSize="16sp"
                    app:cornerRadius="8dp"
                    app:icon="@android:drawable/ic_menu_save"/>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</LinearLayout>